{
  "name": "safeship",
  "version": "0.1.0",
  "description": "Pre-commit security guardrail for vibe coders — catches leaked secrets, unsafe patterns, and vulnerable dependencies before they reach a commit",
  "keywords": [
    "security",
    "pre-commit",
    "git-hooks",
    "secrets",
    "secret-scanning",
    "owasp",
    "sast",
    "cve",
    "husky",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": "ege <ege@projecthebest.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PTB-0/safeship.git"
  },
  "homepage": "https://github.com/PTB-0/safeship#readme",
  "bugs": {
    "url": "https://github.com/PTB-0/safeship/issues"
  },
  "type": "module",
  "bin": {
    "safeship": "bin/safeship.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
